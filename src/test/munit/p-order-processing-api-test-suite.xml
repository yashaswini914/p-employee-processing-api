            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[output application/json --- {operation: 'New', data: [{employeeId: 101, name: 'Alex', address: 'Hyderabad', salary: 50000}]}]" mediaType="application/json"/>

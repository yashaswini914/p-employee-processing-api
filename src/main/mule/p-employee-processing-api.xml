<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
      xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
     
      xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
      http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
      http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
      http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd">

<amqp:config
    name="AMQP_Config"
    doc:name="CloudAMQP RabbitMQ Config"
    createFallbackQueue="false"
    createFallbackExchange="false"
    sendCorrelationId="ALWAYS">

    <amqp:connection
        host="${rabbitmq.host}"
        port="${rabbitmq.port}"
        virtualHost="${rabbitmq.virtualHost}"
        username="${rabbitmq.username}"
        password="${secure::rabbitmq.password}">

        <reconnection>
            <reconnect
                frequency="5000"
                count="5"/>
        </reconnection>

    </amqp:connection>

    <amqp:publisher-config
        requestBrokerConfirms="true"/>

</amqp:config>
	<flow name="p-order-processing-apiraml-main">

        <http:listener
            config-ref="p-order-processing-apiraml-httpListenerConfig"
            path="/api/*"
            doc:name="Receive Order Processing API Request">

            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>

            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>

        </http:listener>

        <apikit:router
            config-ref="p-order-processing-apiraml-config"
            doc:name="Route Order Processing API Request"/>

    </flow>

    <!-- API CONSOLE -->

    <flow name="p-order-processing-apiraml-console">

        <http:listener
            config-ref="p-order-processing-apiraml-httpListenerConfig"
            path="/console/*"
            doc:name="Receive Order API Console Request">

            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>

            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>

        </http:listener>

        <apikit:console
            config-ref="p-order-processing-apiraml-config"
            doc:name="Display Order Processing API Console"/>

        <error-handler>
            <on-error-propagate
                type="APIKIT:NOT_FOUND"
                doc:name="Handle Console Resource Not Found">

                <ee:transform doc:name="Build Console Resource Not Found Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>

            </on-error-propagate>
        </error-handler>

    </flow>

</mule>
